<!DOCTYPE html>
<html lang="en-CA">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#0E1B2C">
<meta name="description" content="{{PAGE_DESC}}">
<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="CanPath">
<title>{{PAGE_TITLE}}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Condensed:wght@600&display=swap" rel="stylesheet">
<style>
/* --ink is "maximum contrast against --paper", not "dark". It is both the
   body text colour and the fill of inverted chips, so --on-ink is whatever
   sits on top of it. Both flip in dark mode and every inverted surface
   follows without a special case. */
:root{
  color-scheme:light;
  --ink:#0E1B2C; --paper:#EEF1F5; --surface:#FFF;
  --claw:#C8102E; --stat:#3D6B99; --keep:#0B7A6B; --gold:#B7791F;
  --rule:#D5DCE5; --muted:#5C6B7F;
  --warn:#8A5A00; --warn-bg:#FDF6E3; --warn-br:#EED9A8; --warn-ink:#4A3B18;
  --good-bg:#ECF7F3; --good-br:#B8DED2;
  --on-ink:#FFF; --on-ink-dim:#9FB2C6; --hover:#0000000D;
  /* Fills only need 3:1 as UI components; small TEXT needs 4.5:1, and
     --gold reaches only 3.64:1 on white. Chart labels use --gold-ink. */
  --gold-ink:#8A5A00;
  --shadow:0 1px 2px #0E1B2C0A;
  --sans:'IBM Plex Sans',system-ui,-apple-system,sans-serif;
  --mono:'IBM Plex Mono',ui-monospace,monospace;
  --cond:'IBM Plex Sans Condensed','IBM Plex Sans',sans-serif;
}
/* Hues are lifted rather than reused: #C8102E and #0B7A6B are tuned for
   contrast on white and go muddy on a dark panel. */
:root[data-theme=dark]{
  color-scheme:dark;
  --ink:#E7EDF4; --paper:#0A121C; --surface:#131E2C;
  --claw:#FF7A8A; --stat:#74A9DC; --keep:#3FBBA1; --gold:#DBA648;
  --rule:#26364C; --muted:#93A4B9;
  --warn:#E8B54B; --warn-bg:#231C0D; --warn-br:#4A3B18; --warn-ink:#F1E0B6;
  --good-bg:#0E2721; --good-br:#1F4C41;
  --on-ink:#0A121C; --on-ink-dim:#48586C; --hover:#FFFFFF14;
  --gold-ink:#DBA648;   /* already 7.65:1 on the dark panel */
  --shadow:0 1px 2px #00000040;
}

/* ============================================================
   TERMINAL — dark ground, amber signature, hard corners.
   Reads as a trading terminal rather than a consumer web app:
   the data is the interface, the chrome gets out of the way.
   Every pair below was measured; the worst text contrast is
   6.24:1 against an AA floor of 4.5.
   ============================================================ */
:root[data-theme=term]{
  color-scheme:dark;
  --ink:#E8E3D8;        /* warm off-white — 15.64:1 on the ground */
  --paper:#080809;      /* terminal black */
  --surface:#101113;    /* panel */
  --rule:#26241F;       /* hairline, decorative only by design */
  --edge:#7A7264;       /* interactive boundary — 3.97:1 / 4.21:1 */
  --muted:#9C9484;
  --stat:#FFB020;       /* AMBER. Your own money, and the house accent */
  --gold:#3FC8F5;       /* cyan — government, kept far from the amber */
  --keep:#2ED573;       /* green — growth */
  --claw:#FF5C5C;       /* red — what you lose */
  --gold-ink:#3FC8F5;
  --on-ink:#080809; --on-ink-dim:#5A5449; --hover:#FFFFFF14;
  --warn:#FFB020; --warn-bg:#1A1405; --warn-br:#3D3010; --warn-ink:#FFD98A;
  --good-bg:#07160E; --good-br:#1B4030;
  --shadow:0 0 0 1px #26241F;
}
/* Square everything. Rounded corners are the single strongest signal of a
   consumer web app, and the terminal look does not survive them. */
:root[data-theme=term] *{border-radius:0!important}
/* Numerals are the content here, so the whole shell goes tabular. */
:root[data-theme=term] body{font-feature-settings:"tnum" 1,"zero" 1}
:root[data-theme=term] .kpi .v,
:root[data-theme=term] .hero-num,
:root[data-theme=term] .aamt,
:root[data-theme=term] .total .v{letter-spacing:0}
/* Amber rails on the panel headers — the terminal's section markers. */
:root[data-theme=term] .panel-head,
:root[data-theme=term] .tabs{border-bottom:1px solid var(--rule)}
:root[data-theme=term] .kpi.hero{box-shadow:inset 3px 0 0 var(--stat)}
:root[data-theme=term] .tab[aria-selected=true]{
  background:transparent;color:var(--stat);border-bottom-color:var(--stat)}
:root[data-theme=term] .navlink[aria-current=page]{color:var(--stat);border-bottom-color:var(--stat)}
/* Controls need a visible boundary on black; --rule is deliberately faint. */
:root[data-theme=term] input[type=number],
:root[data-theme=term] .btn,
:root[data-theme=term] .pills button,
:root[data-theme=term] .seg-ctl,
:root[data-theme=term] .addkid,
:root[data-theme=term] .scnslot,
:root[data-theme=term] .themebtn,
:root[data-theme=term] .kf{border-color:var(--edge)}
:root[data-theme=term] .seg-ctl button+button{border-left-color:var(--edge)}

/* Hairlines between adjacent chart segments. Fills sit at ~1.06:1 against
   each other in every theme, so the boundary is invisible to a colour-
   deficient reader; a --surface rule scores 6.24:1 against all four. */
.split div+div,.dollar div+div,.meter i+i{box-shadow:inset 1px 0 0 var(--surface)}

*{box-sizing:border-box}
/* Author display rules outrank the UA sheet's [hidden]{display:none}, so any
   element given display:flex/grid still rendered while hidden. #allocNote left
   a 23px band and a stray rule in the commonest scenario on the page. */
[hidden]{display:none!important}
html,body{margin:0;padding:0}
body{background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:15px;
  line-height:1.5;-webkit-font-smoothing:antialiased}
.eyebrow{font-family:var(--cond);font-weight:600;text-transform:uppercase;
  letter-spacing:.11em;font-size:11px;color:var(--muted)}
.num{font-family:var(--mono);font-variant-numeric:tabular-nums}

header{border-bottom:1px solid var(--rule);background:var(--surface)}
.mast{max-width:1180px;margin:0 auto;padding:16px 24px;display:flex;align-items:baseline;gap:12px;flex-wrap:wrap}
.wordmark{font-weight:700;font-size:19px;letter-spacing:-.02em}
.wordmark span{color:var(--claw)}
.badge{font-family:var(--mono);font-size:11px;border:1px solid var(--rule);border-radius:3px;padding:2px 7px;color:var(--muted)}
.mast .eyebrow{margin-left:auto}
.navlink{font-family:var(--cond);font-weight:600;font-size:11px;letter-spacing:.09em;
  text-transform:uppercase;color:var(--stat);text-decoration:none;border-bottom:1px solid transparent;
  padding-bottom:1px}
.navlink:hover{border-bottom-color:var(--stat)}
.navlink[aria-current=page]{color:var(--ink);border-bottom-color:var(--ink)}

/* --- learn page --- */
.prose{max-width:1180px;margin:0 auto;padding:22px 24px}
@media(max-width:940px){.prose{padding:14px}}
.lead{font-size:16.5px;line-height:1.6;color:var(--muted);max-width:660px}
.lead b{color:var(--ink);font-weight:600}
.toc{display:flex;flex-wrap:wrap;gap:6px;margin-top:16px}
.toc a{font-family:var(--mono);font-size:12px;border:1px solid var(--rule);border-radius:999px;
  padding:4px 11px;color:var(--muted);text-decoration:none}
.toc a:hover{border-color:var(--stat);color:var(--stat)}
.sec{scroll-margin-top:16px}
.sec h2{font-size:19px;letter-spacing:-.01em;margin:0}
.sec h3{font-size:14.5px;margin:20px 0 4px}
.sec h3:first-child{margin-top:0}
.ltext{font-size:14px;line-height:1.65;color:var(--muted);max-width:720px}
.ltext p{margin:9px 0}
.ltext b,.ltext strong{color:var(--ink);font-weight:600}
.ltext ul{margin:9px 0;padding-left:19px}
.ltext li{margin:5px 0}
.ltext .num{color:var(--ink);font-weight:600}
.ltext a{color:var(--stat)}
.keyfacts{display:flex;flex-wrap:wrap;gap:8px;margin:12px 0 2px}
.kf{border:1px solid var(--rule);border-radius:5px;padding:7px 11px;background:var(--paper);min-width:120px}
.kf .k{font-family:var(--cond);font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--muted)}
.kf .v{font-family:var(--mono);font-size:15px;font-weight:600;margin-top:1px}
.callout{border-left:3px solid var(--stat);background:var(--paper);border-radius:0 5px 5px 0;
  padding:11px 14px;margin:14px 0;font-size:13px;line-height:1.6}
.callout.warnbox{border-left-color:var(--warn);background:var(--warn-bg);color:var(--warn-ink)}
.callout .t{font-family:var(--cond);font-size:10px;letter-spacing:.09em;text-transform:uppercase;
  color:var(--muted);display:block;margin-bottom:3px}
.callout.warnbox .t{color:var(--warn)}
.tablewrap{overflow-x:auto;margin:14px 0;border:1px solid var(--rule);border-radius:5px}
table.lt{border-collapse:collapse;width:100%;min-width:560px;font-size:13px}
table.lt th,table.lt td{text-align:left;padding:9px 12px;border-bottom:1px solid var(--rule);vertical-align:top}
table.lt tr:last-child td{border-bottom:0}
table.lt th{font-family:var(--cond);font-size:10px;letter-spacing:.09em;text-transform:uppercase;
  color:var(--muted);background:var(--paper);white-space:nowrap}
table.lt td.n{font-family:var(--mono);white-space:nowrap}

/* --- theme toggle --- */
.themebtn{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--rule);
  background:var(--surface);color:var(--muted);border-radius:999px;padding:4px 11px 4px 9px;
  font-family:var(--cond);font-weight:600;font-size:10.5px;letter-spacing:.09em;
  text-transform:uppercase;cursor:pointer;align-self:center;transition:.15s}
.themebtn:hover{color:var(--ink);border-color:var(--stat)}
.themebtn svg{width:14px;height:14px;display:block;fill:none;stroke:currentColor;
  stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.themebtn .moon,.themebtn .term{display:none}
:root[data-theme=dark] .themebtn .moon{display:block}
:root[data-theme=dark] .themebtn .sun{display:none}
:root[data-theme=term] .themebtn .term{display:block}
:root[data-theme=term] .themebtn .sun{display:none}
:root[data-theme=term] .themebtn{color:var(--stat);border-color:var(--edge)}

.shell{max-width:1180px;margin:0 auto;padding:22px 24px;display:grid;
  grid-template-columns:330px minmax(0,1fr);gap:22px;align-items:start}
@media(max-width:940px){.shell{grid-template-columns:1fr;padding:14px;gap:14px}}

/* ============================================================
   APP SHELL — the institutional layout
   ============================================================ */
.app{max-width:1500px;margin:0 auto;padding:0 20px 40px}
@media(max-width:1020px){.app{padding:0 12px 28px}}

/* KPI strip: the six numbers a reviewer checks before reading anything */
.kpis{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:1px;
  background:var(--rule);border:1px solid var(--rule);border-radius:7px;
  overflow:hidden;margin:16px 0}
@media(max-width:1240px){.kpis{grid-template-columns:repeat(3,minmax(0,1fr))}}
@media(max-width:640px){.kpis{grid-template-columns:repeat(2,minmax(0,1fr))}}
/* Four-up variant for the Allocate page. A class, not an inline style: an
   inline grid-template-columns outranks the media queries above, so the
   columns never collapse and every label clips at narrow widths. */
.kpis.four{grid-template-columns:repeat(4,minmax(0,1fr))}
@media(max-width:1100px){.kpis.four{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:520px){.kpis.four{grid-template-columns:1fr}}
.kpi{background:var(--surface);padding:11px 14px 12px;min-width:0}
.kpi .k{font-family:var(--cond);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--muted);display:flex;align-items:center;gap:5px;white-space:nowrap;
  overflow:hidden;text-overflow:ellipsis}
.kpi .v{font-family:var(--mono);font-size:20px;font-weight:600;letter-spacing:-.02em;
  margin-top:3px;line-height:1.15;font-variant-numeric:tabular-nums}
.kpi .s{font-size:10.5px;color:var(--muted);margin-top:2px;line-height:1.3}
.kpi.hero .v{color:var(--keep);font-size:23px}
/* Named neg/pos, not warn/ok: `.warn` is already the guardrail callout box
   (flex, padding, background) and a KPI value picking that up inherits a
   whole box it should not have. */
.kpi .v.neg{color:var(--claw)}
.kpi .v.pos{color:var(--keep)}
.dot{width:6px;height:6px;border-radius:50%;flex:none;display:inline-block}

.workspace{display:grid;grid-template-columns:308px minmax(0,1fr);gap:16px;align-items:start}
@media(max-width:1020px){.workspace{grid-template-columns:1fr}}
.rail{position:sticky;top:14px;max-height:calc(100vh - 28px);overflow-y:auto;
  background:var(--surface);border:1px solid var(--rule);border-radius:7px}
@media(max-width:1020px){.rail{position:static;max-height:none}}
.rail::-webkit-scrollbar{width:8px}
.rail::-webkit-scrollbar-thumb{background:var(--rule);border-radius:4px}

/* Collapsible input groups keep a long form navigable */
.grp{border-bottom:1px solid var(--rule)}
.grp:last-child{border-bottom:0}
.grp>summary{padding:10px 14px;cursor:pointer;list-style:none;display:flex;
  align-items:center;justify-content:space-between;gap:8px;
  font-family:var(--cond);font-weight:600;font-size:10.5px;letter-spacing:.1em;
  text-transform:uppercase;color:var(--muted)}
.grp>summary::-webkit-details-marker{display:none}
.grp>summary::after{content:"−";font-family:var(--mono);font-size:14px;color:var(--muted)}
.grp:not([open])>summary::after{content:"+"}
.grp>summary:hover{color:var(--ink);background:var(--hover)}
.grp .grpbody{padding:2px 14px 14px}

/* Tabs */
.tabs{display:flex;gap:2px;border:1px solid var(--rule);background:var(--surface);
  border-radius:7px 7px 0 0;padding:5px 5px 0;overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab{border:0;background:none;padding:9px 15px;cursor:pointer;white-space:nowrap;
  font-family:var(--cond);font-weight:600;font-size:11px;letter-spacing:.09em;
  text-transform:uppercase;color:var(--muted);border-bottom:2px solid transparent;
  border-radius:4px 4px 0 0}
.tab:hover{color:var(--ink);background:var(--hover)}
.tab[aria-selected=true]{color:var(--ink);border-bottom-color:var(--stat);background:var(--paper)}
.tabpanel{border:1px solid var(--rule);border-top:0;border-radius:0 0 7px 7px;
  background:var(--surface)}
.tabpanel[hidden]{display:none}
.block{border-bottom:1px solid var(--rule);padding:16px 18px}
.block:last-child{border-bottom:0}
.block-h{display:flex;justify-content:space-between;align-items:baseline;gap:10px;
  flex-wrap:wrap;margin-bottom:12px}
.block-h h3{margin:0;font-size:13.5px;letter-spacing:-.01em}
.block-h .sub{font-size:11.5px;color:var(--muted)}

/* Data table — institutional readers want the numbers, not only the picture */
.dt-wrap{overflow-x:auto;border:1px solid var(--rule);border-radius:5px;max-height:440px}
table.dt{border-collapse:collapse;width:100%;min-width:660px;font-size:12.5px}
table.dt th,table.dt td{padding:6px 11px;border-bottom:1px solid var(--rule);text-align:right;
  font-family:var(--mono);font-variant-numeric:tabular-nums;white-space:nowrap}
table.dt th{position:sticky;top:0;background:var(--paper);z-index:1;
  font-family:var(--cond);font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;
  color:var(--muted);text-align:right}
table.dt th:first-child,table.dt td:first-child{text-align:left}
table.dt tbody tr:hover{background:var(--hover)}
table.dt tr.mark td{background:var(--good-bg)}
table.dt tr:last-child td{border-bottom:0}

/* Small controls */
.btn{border:1px solid var(--rule);background:var(--surface);color:var(--muted);
  border-radius:5px;padding:5px 11px;font-family:var(--cond);font-weight:600;
  font-size:10.5px;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;
  display:inline-flex;align-items:center;gap:6px;transition:.15s}
.btn:hover{color:var(--ink);border-color:var(--stat)}
.btn.primary{background:var(--stat);color:var(--on-ink);border-color:var(--stat)}
.btn.primary:hover{opacity:.9;color:var(--on-ink)}
.btnrow{display:flex;gap:6px;flex-wrap:wrap}

/* Scenario compare */
.scn{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.scnslot{border:1px dashed var(--rule);border-radius:6px;padding:10px 12px;min-height:74px}
.scnslot.filled{border-style:solid;background:var(--paper)}
.scnslot .t{font-family:var(--cond);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;
  color:var(--muted);display:flex;justify-content:space-between;align-items:center;gap:6px}
.scnslot .t button{border:0;background:none;color:var(--muted);cursor:pointer;
  font-size:14px;line-height:1;padding:0 2px}
.scnslot .t button:hover{color:var(--claw)}
.scnslot .v{font-family:var(--mono);font-size:16px;font-weight:600;margin-top:4px}
.scnslot .d{font-size:10.5px;color:var(--muted);margin-top:2px;line-height:1.35}
.delta{font-family:var(--mono);font-weight:600}
.delta.up{color:var(--keep)}.delta.down{color:var(--claw)}

.assum{font-size:11px;color:var(--muted);line-height:1.5;margin-top:9px;
  border-top:1px dashed var(--rule);padding-top:9px}
.assum b{color:var(--ink);font-family:var(--mono);font-weight:600}

.statline{display:flex;gap:18px;flex-wrap:wrap;font-size:12px;color:var(--muted);
  padding:9px 18px;background:var(--paper);border-top:1px solid var(--rule)}
.statline b{font-family:var(--mono);color:var(--ink);font-weight:600}

/* Print: one clean report, no chrome */
@media print{
  header,.rail,.tabs,.btn,.btnrow,.themebtn,.navlink,footer .noprint{display:none!important}
  .tabpanel[hidden]{display:block!important}
  .app{max-width:none;padding:0}
  .workspace{grid-template-columns:1fr}
  .panel,.tabpanel,.kpis{break-inside:avoid;border-color:#999}
  body{background:#fff;color:#000;font-size:11pt}
  .block{break-inside:avoid}
}
.panel{background:var(--surface);border:1px solid var(--rule);border-radius:6px;margin-bottom:20px}
.panel:last-child{margin-bottom:0}
.panel-head{padding:13px 18px;border-bottom:1px solid var(--rule);display:flex;
  justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap}
.panel-body{padding:18px}
aside{position:sticky;top:20px}
@media(max-width:940px){aside{position:static}}

/* --- form --- */
.field{margin-bottom:15px}
.field:last-child{margin-bottom:0}
label{display:block;font-size:12.5px;font-weight:500;margin-bottom:5px}
.hint{font-size:11.5px;color:var(--muted);margin-top:4px;line-height:1.4}
input[type=number]{width:100%;padding:8px 10px;border:1px solid var(--rule);border-radius:4px;
  font-family:var(--mono);font-size:14px;background:var(--surface);color:var(--ink)}
input[type=range]{width:100%;accent-color:var(--stat)}
input:focus-visible,button:focus-visible{outline:2px solid var(--stat);outline-offset:2px}
.row{display:flex;gap:8px;align-items:center}
.divider{height:1px;background:var(--rule);margin:16px -18px}

/* --- segmented toggles --- */
.seg-ctl{display:flex;border:1px solid var(--rule);border-radius:5px;overflow:hidden;background:var(--paper)}
.seg-ctl button{flex:1;border:0;background:none;padding:8px 6px;font-family:var(--sans);
  font-size:12.5px;font-weight:500;cursor:pointer;color:var(--muted);transition:.15s}
.seg-ctl button+button{border-left:1px solid var(--rule)}
.seg-ctl button[aria-pressed=true]{background:var(--ink);color:var(--on-ink)}
.seg-ctl button:hover:not([aria-pressed=true]){background:var(--surface);color:var(--ink)}

.kids{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.kid{display:inline-flex;align-items:center;gap:4px;background:var(--paper);border:1px solid var(--rule);
  border-radius:999px;padding:3px 5px 3px 11px;font-size:12.5px}
.kid button{border:0;background:none;cursor:pointer;color:var(--muted);font-size:15px;line-height:1;padding:2px 5px;border-radius:50%}
.kid button:hover{color:var(--claw);background:var(--hover)}
.addkid{border:1px dashed var(--rule);background:none;border-radius:999px;padding:4px 12px;
  font-size:12.5px;cursor:pointer;color:var(--muted);font-family:var(--sans)}
.addkid:hover{border-color:var(--stat);color:var(--stat)}

/* --- hero --- */
/* Scoped: bare .hero came LATER than .kpi at equal specificity, so it won the
   cascade and made the first KPI tile 26px taller than its siblings. */
main>.hero{padding:24px 24px 22px;text-align:left}
.hero .eyebrow{margin-bottom:8px}
.hero-num{font-family:var(--mono);font-size:clamp(38px,7vw,62px);font-weight:600;
  letter-spacing:-.03em;line-height:1;color:var(--keep)}
.hero-sub{font-size:13.5px;color:var(--muted);margin-top:8px;max-width:560px;line-height:1.5}
.hero-sub b{color:var(--ink);font-family:var(--mono);font-weight:600}
.split{display:flex;height:38px;border-radius:4px;overflow:hidden;border:1px solid var(--rule);margin-top:18px}
.split div{transition:width .3s cubic-bezier(.4,0,.2,1)}
.sp-you{background:var(--stat)}.sp-grow{background:var(--keep)}.sp-gov{background:var(--gold)}
.splitkey{display:flex;gap:20px;margin-top:11px;flex-wrap:wrap}
.spk{display:flex;gap:7px;align-items:flex-start;font-size:11.5px;color:var(--muted)}
.spk i{width:10px;height:10px;border-radius:2px;margin-top:3px;flex:none;display:block}
.spk b{display:block;font-family:var(--mono);font-size:15px;color:var(--ink);font-weight:600}

/* --- pills --- */
.pills{display:flex;gap:5px;flex-wrap:wrap}
.pills button{border:1px solid var(--rule);background:var(--surface);border-radius:999px;
  padding:4px 11px;font-family:var(--mono);font-size:12px;cursor:pointer;color:var(--muted)}
.pills button[aria-pressed=true]{background:var(--ink);color:var(--on-ink);border-color:var(--ink)}
/* The one rung that tracks the user's own inputs rather than a round
   number, and the view the chart opens on. Marked so it does not read as
   just another fixed step. */
.pills button.pill-var{border-style:dashed;border-color:var(--stat);color:var(--stat)}
.pills button.pill-var[aria-pressed=true]{background:var(--stat);color:var(--on-ink);
  border-style:solid;border-color:var(--stat)}

/* pan-y, not none: `none` made every chart a dead zone where a vertical
   swipe did nothing, ~260px of unscrollable page on a phone. Horizontal
   drags still reach pointermove, so the scrub survives. */
svg{display:block;width:100%;height:auto;touch-action:pan-y}
.axis{font-family:var(--mono);font-size:11px;fill:var(--muted)}
.gridline{stroke:var(--rule);stroke-width:1}
/* Dashed rules recede behind the data; the baseline stays solid so the
   chart sits on something rather than floating. */
.gridline-d{stroke:var(--rule);stroke-width:1;stroke-dasharray:2 4}
.axis-base{stroke:var(--rule);stroke-width:1.25}
.chart-note{font-family:var(--cond);font-size:10px;fill:var(--muted);
  letter-spacing:.09em;text-transform:uppercase}
.guide{stroke:var(--ink);stroke-width:1;stroke-dasharray:3 3;opacity:.3}
.tip-box{fill:var(--ink)}
.tip-k{font-family:var(--cond);font-size:9.5px;fill:var(--on-ink-dim);letter-spacing:.1em;text-transform:uppercase}
.tip-v{font-family:var(--mono);font-size:13px;font-weight:600;fill:var(--on-ink)}
.chartwrap{padding:16px 18px}
.readout{background:var(--paper);border-top:1px solid var(--rule);padding:10px 18px;
  font-size:12.5px;display:flex;gap:18px;flex-wrap:wrap}
.readout b{font-family:var(--mono);font-weight:600}

/* --- track meter --- */
.track{padding:18px}
.meter{height:26px;background:var(--paper);border:1px solid var(--rule);border-radius:4px;
  overflow:hidden;position:relative;display:flex}
.meter i{display:block;height:100%;transition:width .3s}
.m-gov{background:var(--gold)}.m-port{background:var(--keep)}
.meter .target{position:absolute;top:-4px;bottom:-4px;width:2px;background:var(--ink)}
.trackrow{display:flex;justify-content:space-between;gap:14px;margin-top:12px;flex-wrap:wrap;font-size:12.5px}
.trackrow b{font-family:var(--mono);font-weight:600}
.verdict{margin-top:14px;padding:12px 14px;border-radius:5px;font-size:13px;line-height:1.5}
.v-good{background:var(--good-bg);border:1px solid var(--good-br)}
.v-gap{background:var(--warn-bg);border:1px solid var(--warn-br);color:var(--warn-ink)}
.verdict b{font-family:var(--mono);font-weight:600}

/* --- allocation --- */
.arow{display:grid;grid-template-columns:24px 1fr auto;gap:12px;align-items:center;
  padding:13px 18px;border-bottom:1px solid var(--rule)}
.arow:last-child{border-bottom:0}
.rank{font-family:var(--mono);font-size:11px;color:var(--muted);text-align:right}
.aname{font-weight:600;font-size:13.5px}
.aname .full{font-weight:400;color:var(--muted);font-size:11.5px}
.awhy{font-size:11.5px;color:var(--muted);line-height:1.45;margin-top:2px}
.aamt{font-family:var(--mono);font-size:16px;font-weight:600;text-align:right;white-space:nowrap}
.total{display:flex;justify-content:space-between;align-items:baseline;gap:12px;
  padding:14px 18px;background:var(--ink);color:var(--on-ink);flex-wrap:wrap}
.total .v{font-family:var(--mono);font-size:25px;font-weight:600}
.total .k{font-size:12px;opacity:.85}
.bd{padding:11px 18px;font-size:12.5px;color:var(--muted);display:flex;gap:16px;flex-wrap:wrap;border-top:1px solid var(--rule)}
.bd b{font-family:var(--mono);color:var(--ink);font-weight:600}
.warn{display:flex;gap:10px;padding:12px 18px;background:var(--warn-bg);
  border-top:1px solid var(--warn-br);font-size:12.5px;line-height:1.45;color:var(--warn-ink)}
.warn .mark{color:var(--warn);font-weight:700;flex:none}

/* --- dollar bar --- */
.dollar{display:flex;height:44px;border-radius:4px;overflow:hidden;border:1px solid var(--rule)}
.dollar div{transition:width .28s}
.d-tax{background:var(--stat)}.d-claw{background:var(--claw)}.d-keep{background:var(--keep)}

/* --- explainer --- */
details{border-top:1px solid var(--rule)}
summary{padding:11px 18px;cursor:pointer;font-size:12.5px;color:var(--stat);font-weight:500;list-style:none}
summary::-webkit-details-marker{display:none}
summary::before{content:"＋ ";font-family:var(--mono)}
details[open] summary::before{content:"− "}
details .panel-body{padding-top:0;font-size:13px;color:var(--muted);line-height:1.6}
details dt{font-weight:600;color:var(--ink);font-size:13px;margin-top:12px}
details dt:first-child{margin-top:0}
details dd{margin:3px 0 0}

footer{max-width:1180px;margin:0 auto;padding:6px 24px 40px;font-size:11.5px;color:var(--muted);line-height:1.55}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
<script>
/* Resolve the theme before first paint. A theme applied from the main
   script, which runs at the end of <body>, is a full white flash on every
   load for anyone using dark mode. */
(function(){
  var KEY="canpath-theme", saved=null;
  try{saved=localStorage.getItem(KEY);}catch(e){}
  var explicit=(saved==="dark"||saved==="light"||saved==="term");
  var sys=window.matchMedia&&window.matchMedia("(prefers-color-scheme:dark)").matches;
  /* Terminal is the house look; the OS preference only decides the
     fallback once someone has explicitly chosen light or dark. */
  document.documentElement.dataset.theme=explicit?saved:"term";
  window.__theme={key:KEY,explicit:explicit};
})();
</script>
</head>
<body>
<header><div class="mast">
  <div class="wordmark">Can<span>Path</span></div>
  <span class="badge">2026</span>
  <span class="badge">British Columbia</span>
{{NAV}}
  <span class="eyebrow">Educational model — not financial advice</span>
  <button class="themebtn" id="themeBtn" type="button" aria-pressed="false">
    <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.4v2.4M12 19.2v2.4M4.2 12H1.8M22.2 12h-2.4M6.5 6.5 4.8 4.8M19.2 19.2l-1.7-1.7M17.5 6.5l1.7-1.7M4.8 19.2l1.7-1.7"/></svg>
    <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.6A8.6 8.6 0 0 1 9.4 3.5a8.6 8.6 0 1 0 11.1 11.1Z"/></svg>
    <svg class="term" viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 4.5h17v15h-17z"/><path d="M7 9.5l3 2.5-3 2.5M12.5 15h4.5"/></svg>
    <span id="themeLabel">Light</span>
  </button>
</div></header>
