<div class="app">

<!-- ============ KPI STRIP ============ -->
<div class="kpis" id="kpis">
  <div class="kpi hero">
    <div class="k">Projected balance <span id="kpiAgeLbl"></span></div>
    <div class="v" id="kBalance">$0</div>
    <div class="s" id="kBalanceSub">—</div>
  </div>
  <div class="kpi">
    <div class="k"><span class="dot" style="background:var(--claw)"></span>Effective marginal rate</div>
    <div class="v" id="kEmr">0%</div>
    <div class="s" id="kEmrSub">—</div>
  </div>
  <div class="kpi">
    <div class="k"><span class="dot" style="background:var(--gold)"></span>Government help, year 1</div>
    <div class="v" id="kGov">$0</div>
    <div class="s" id="kGovSub">—</div>
  </div>
  <div class="kpi">
    <div class="k">Target coverage</div>
    <div class="v" id="kCover">—</div>
    <div class="s" id="kCoverSub">—</div>
  </div>
  <div class="kpi">
    <div class="k">Growth overtakes</div>
    <div class="v" id="kCross">—</div>
    <div class="s" id="kCrossSub">—</div>
  </div>
  <div class="kpi">
    <div class="k">Registered room used</div>
    <div class="v" id="kRoom">—</div>
    <div class="s" id="kRoomSub">—</div>
  </div>
</div>

<div class="workspace">

<!-- ============ INPUT RAIL ============ -->
<aside class="rail">

  <details class="grp" open>
    <summary>Profile</summary>
    <div class="grpbody">
      <div class="field">
        <label>Province</label>
        <div class="seg-ctl" id="prov" role="group" aria-label="Province"></div>
        <div class="hint" id="provNote"></div>
      </div>
      <div class="field">
        <label>Household</label>
        <div class="seg-ctl" id="marital">
          <button type="button" data-v="single" aria-pressed="true">Single</button>
          <button type="button" data-v="couple" aria-pressed="false">Partnered</button>
        </div>
      </div>
      <div class="field">
        <label>Children under 18</label>
        <div class="seg-ctl" id="haskids">
          <button type="button" data-v="no" aria-pressed="true">None</button>
          <button type="button" data-v="yes" aria-pressed="false">I have children</button>
        </div>
        <div id="kidsWrap" hidden>
          <div class="kids" id="kids"></div>
          <div class="hint">Under 6 carries a larger benefit than 6–17.</div>
        </div>
      </div>
      <div class="field">
        <label for="age">Age, and when you stop working</label>
        <div class="row">
          <input type="number" id="age" value="32" min="16" max="80" step="1" aria-label="Current age">
          <span class="hint" style="margin:0;white-space:nowrap">→ retire at</span>
          <input type="number" id="retage" value="65" min="45" max="100" step="1" aria-label="Retirement age">
        </div>
      </div>
    </div>
  </details>

  <details class="grp" open>
    <summary>Income &amp; savings</summary>
    <div class="grpbody">
      <div class="field">
        <label for="income">Employment income</label>
        <input type="number" id="income" value="68000" min="0" max="500000" step="1000">
        <input type="range" id="incomeRange" value="68000" min="0" max="300000" step="1000" aria-label="Employment income">
      </div>
      <div class="field" id="partnerField" hidden>
        <label for="partner">Partner's income</label>
        <input type="number" id="partner" value="55000" min="0" max="500000" step="1000">
      </div>
      <div class="field">
        <label for="save">Monthly savings</label>
        <input type="number" id="save" value="500" min="0" max="20000" step="50">
        <details class="grp" id="saveWork" style="border:1px solid var(--rule);margin-top:8px">
          <summary>Work it out from your pay</summary>
          <div class="grpbody">
            <div class="assum" style="border:0;padding:0;margin:0 0 8px">
              Take-home is computed from the income above, after federal tax,
              provincial tax, CPP and EI. Nothing here is stored.
            </div>
            <table class="dt" style="min-width:0;font-size:12.5px">
              <tbody>
                <tr><td>Take-home, monthly</td><td id="wTake">$0</td></tr>
                <tr><td><label for="wHousing" style="margin:0;font-weight:400">Housing</label></td>
                    <td><input type="number" id="wHousing" value="0" min="0" max="20000" step="50"
                        style="width:96px;padding:4px 6px" aria-label="Monthly housing cost"></td></tr>
                <tr><td><label for="wFixed" style="margin:0;font-weight:400">Other fixed</label></td>
                    <td><input type="number" id="wFixed" value="0" min="0" max="20000" step="50"
                        style="width:96px;padding:4px 6px" aria-label="Other fixed monthly costs"></td></tr>
                <tr><td><label for="wVar" style="margin:0;font-weight:400">Variable</label></td>
                    <td><input type="number" id="wVar" value="0" min="0" max="20000" step="50"
                        style="width:96px;padding:4px 6px" aria-label="Variable monthly spending"></td></tr>
                <tr class="mark"><td><b>Left over</b></td><td><b id="wLeft">$0</b></td></tr>
              </tbody>
            </table>
            <div class="btnrow" style="margin-top:9px">
              <button class="btn primary" type="button" id="wUse">Use this figure</button>
            </div>
            <div class="assum" id="wNote"></div>
          </div>
        </details>
      </div>
      <div class="field">
        <label for="have">Already invested</label>
        <input type="number" id="have" value="10000" min="0" max="5000000" step="1000">
      </div>
      <div class="field">
        <label for="target">Target retirement income</label>
        <input type="number" id="target" value="50000" min="0" max="300000" step="1000">
        <div class="hint">Many people aim for roughly 60–70% of what they earn now.</div>
      </div>
    </div>
  </details>

  <details class="grp" open>
    <summary>Accounts available</summary>
    <div class="grpbody">
      <div class="field">
        <label class="row" style="gap:8px;cursor:pointer;font-size:13px">
          <input type="checkbox" id="fhsa" checked style="accent-color:var(--stat)">
          <span>I could buy a first home someday</span>
        </label>
        <div class="hint">Unlocks the FHSA — deductible going in and tax-free coming out.</div>
      </div>
      <div class="field">
        <label class="row" style="gap:8px;cursor:pointer;font-size:13px">
          <input type="checkbox" id="hasMatch" style="accent-color:var(--stat)">
          <span>My employer matches my retirement contributions</span>
        </label>
        <div class="hint">Check your benefits handbook. This is free money and it is routinely left unclaimed.</div>
        <div id="matchWrap" hidden>
          <div class="row" style="margin-top:9px">
            <input type="number" id="matchRate" value="50" min="0" max="200" step="5" aria-label="Cents matched per dollar">
            <span class="hint" style="margin:0;white-space:nowrap">¢ per $1, up to</span>
            <input type="number" id="matchCap" value="3000" min="0" max="50000" step="500" aria-label="Most the employer will match per year">
          </div>
          <div class="hint">A 50¢ match up to $3,000 is a common plan. Replace both with yours.</div>
        </div>
      </div>
    </div>
  </details>

  <details class="grp">
    <summary>Assumptions</summary>
    <div class="grpbody">
      <div class="field">
        <label for="growth">Annual investment growth</label>
        <div class="row">
          <input type="range" id="growth" value="8" min="0" max="12" step="0.5" style="flex:1">
          <span class="num" id="growthOut" style="width:52px;text-align:right;font-weight:600">8.0%</span>
        </div>
        <div class="hint" id="realHint"></div>
      </div>
      <div class="field">
        <label for="retrate">Expected tax rate when you withdraw</label>
        <div class="row">
          <input type="range" id="retrate" value="25" min="0" max="55" step="1" style="flex:1">
          <span class="num" id="retrateOut" style="width:52px;text-align:right;font-weight:600">25%</span>
        </div>
        <div class="hint">The RRSP decision turns entirely on this. Below your current
        effective rate, an RRSP gains; above it, an RRSP loses.</div>
      </div>
      <div class="field">
        <label for="wdraw">Sustainable withdrawal rate</label>
        <div class="row">
          <input type="range" id="wdraw" value="4" min="2" max="8" step="0.25" style="flex:1">
          <span class="num" id="wdrawOut" style="width:52px;text-align:right;font-weight:600">4.0%</span>
        </div>
        <div class="hint">Sets the nest egg your target income implies.</div>
      </div>
      <div class="field">
        <label for="cppstart">When you start CPP</label>
        <div class="row">
          <input type="range" id="cppstart" value="65" min="60" max="70" step="1" style="flex:1">
          <span class="num" id="cppstartOut" style="width:52px;text-align:right;font-weight:600">65</span>
        </div>
        <div class="hint" id="cppstartHint"></div>
      </div>
      <div class="field">
        <label for="cppshare">CPP relative to the average</label>
        <div class="row">
          <input type="range" id="cppshare" value="100" min="0" max="163" step="1" style="flex:1">
          <span class="num" id="cppshareOut" style="width:52px;text-align:right;font-weight:600">100%</span>
        </div>
        <div class="hint">100% is the average new pension at 65, not the maximum.</div>
      </div>
      <div class="field">
        <label>Reporting basis</label>
        <div class="seg-ctl" id="basis">
          <button type="button" data-v="nominal" aria-pressed="true">Future dollars</button>
          <button type="button" data-v="real" aria-pressed="false">Today's dollars</button>
        </div>
        <div class="hint" id="basisHint"></div>
      </div>
    </div>
  </details>

  <details class="grp" open>
    <summary>Scenarios</summary>
    <div class="grpbody">
      <div class="scn">
        <div class="scnslot" id="slotA">
          <div class="t"><span>Scenario A</span><button type="button" id="clrA" title="Clear" hidden>&times;</button></div>
          <div class="v" id="valA">—</div>
          <div class="d" id="desA">Not saved</div>
        </div>
        <div class="scnslot" id="slotB">
          <div class="t"><span>Scenario B</span><button type="button" id="clrB" title="Clear" hidden>&times;</button></div>
          <div class="v" id="valB">—</div>
          <div class="d" id="desB">Not saved</div>
        </div>
      </div>
      <div class="btnrow" style="margin-top:9px">
        <button class="btn" type="button" id="saveA">Save as A</button>
        <button class="btn" type="button" id="saveB">Save as B</button>
      </div>
      <div class="assum" id="scnDelta" hidden></div>
    </div>
  </details>

  <details class="grp">
    <summary>Share &amp; export</summary>
    <div class="grpbody">
      <div class="btnrow">
        <button class="btn" type="button" id="copyLink">Copy link to these inputs</button>
        <button class="btn" type="button" id="dlCsv">Download schedule (CSV)</button>
        <button class="btn" type="button" id="doPrint">Print report</button>
      </div>
      <div class="assum" id="shareMsg">Every input is encoded in the address bar, so a
      link reproduces this exact scenario. Nothing is uploaded.</div>
    </div>
  </details>

</aside>

<!-- ============ WORKSPACE ============ -->
<main style="min-width:0">
  <div class="tabs" role="tablist">
    <button class="tab" role="tab" id="tabbtn-proj" aria-controls="tab-proj" aria-selected="true">Projection</button>
    <button class="tab" role="tab" id="tabbtn-marg" aria-controls="tab-marg" aria-selected="false">Marginal rate</button>
    <button class="tab" role="tab" id="tabbtn-sched" aria-controls="tab-sched" aria-selected="false">Schedule</button>
  </div>

  <!-- PROJECTION -->
  <section class="tabpanel" id="tab-proj" role="tabpanel" aria-labelledby="tabbtn-proj">
    <div class="block">
      <div class="block-h">
        <h3>Balance over time</h3>
        <span style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          <span class="seg-ctl" id="chartview" style="width:auto">
            <button type="button" data-v="linear" aria-pressed="true">Linear</button>
            <button type="button" data-v="log" aria-pressed="false">Log</button>
          </span>
          <label class="row" style="gap:6px;cursor:pointer;font-size:11.5px;color:var(--muted);margin:0">
            <input type="checkbox" id="showBand" checked style="accent-color:var(--stat)">
            <span>Show ±2% range</span>
          </label>
          <span class="pills" id="horizons"></span>
        </span>
      </div>
      <div class="chartwrap" style="padding:0"><svg id="growthChart" viewBox="0 0 760 300" preserveAspectRatio="xMidYMid meet"></svg></div>
    </div>
    <div class="statline" id="growthRead"></div>
    <div class="statline" id="milestones" style="border-top:0"></div>
    <div class="block">
      <div class="block-h">
        <h3>Composition at the horizon</h3>
        <span class="sub">What builds the balance</span>
      </div>
      <div class="split" role="img" id="splitBar" style="margin-top:0">
        <div class="sp-you" id="spYou"></div>
        <div class="sp-grow" id="spGrow"></div>
        <div class="sp-gov" id="spGov"></div>
      </div>
      <div class="splitkey">
        <span class="spk"><i style="background:var(--stat)"></i><span><b id="kYou">$0</b>you contribute</span></span>
        <span class="spk"><i style="background:var(--keep)"></i><span><b id="kGrow">$0</b>growth</span></span>
        <span class="spk"><i style="background:var(--gold)"></i><span><b id="kGovFV">$0</b>government help, reinvested</span></span>
      </div>
    </div>
    <div class="block" style="padding:0">
      <div class="block-h" style="padding:16px 18px 0;margin-bottom:10px">
        <h3>Where your money should go</h3>
        <span class="sub"><span id="homeAllocSub">—</span> · <a href="allocate.html">Full breakdown &amp; room →</a></span>
      </div>
      <div id="homeAlloc"></div>
      <div class="bd" id="homeAllocNote" hidden></div>
      <div id="homeWarnings"></div>
    </div>
    <div class="block">
      <div class="block-h"><h3>Retirement readiness</h3><span class="sub" id="readySub"></span></div>
      <div class="meter" id="meter">
        <i class="m-gov" id="mGov"></i><i class="m-port" id="mPort"></i>
        <span class="target" id="mTarget"></span>
      </div>
      <div class="trackrow">
        <span>Government pensions (CPP + OAS) <b id="tGov">$0</b></span>
        <span>From your investments <b id="tPort">$0</b></span>
        <span>Your target <b id="tTarget">$0</b></span>
      </div>
      <div class="verdict" id="verdict"></div>
      <div class="assum" id="depletion"></div>
      <div class="assum" id="oasClaw" hidden></div>
    </div>
    <div class="block">
      <div class="block-h">
        <h3>When to start CPP</h3>
        <span class="sub">Taking it early costs 0.6% a month; deferring pays 0.7%</span>
      </div>
      <div class="dt-wrap" style="max-height:none">
        <table class="dt" style="min-width:420px"><thead><tr>
          <th>Start at</th><th>Annual CPP</th><th>vs age 65</th><th>Break-even vs 60</th>
        </tr></thead><tbody id="cppTable"></tbody></table>
      </div>
      <div class="assum" id="cppNote"></div>
    </div>
    <div class="block">
      <div class="block-h"><h3>The cost of waiting</h3><span class="sub">A five-year delay</span></div>
      <div id="waitBox"></div>
    </div>
  </section>

  <!-- MARGINAL RATE -->
  <section class="tabpanel" id="tab-marg" role="tabpanel" aria-labelledby="tabbtn-marg" hidden>
    <div class="block">
      <div class="block-h">
        <h3>Effective marginal rate across income</h3>
        <span class="sub">Income tax plus benefit clawback, at your household</span>
      </div>
      <div class="chartwrap" style="padding:0"><svg id="emrChart" viewBox="0 0 760 300" preserveAspectRatio="xMidYMid meet"></svg></div>
    </div>
    <div class="statline" id="emrRead"></div>
    <div class="block">
      <div class="block-h"><h3>Your next dollar</h3><span class="sub" id="dollarIntro"></span></div>
      <div class="dollar" role="img" id="dollarBar">
        <div class="d-tax" id="dTax"></div><div class="d-claw" id="dClaw"></div><div class="d-keep" id="dKeep"></div>
      </div>
      <div class="splitkey">
        <span class="spk"><i style="background:var(--stat)"></i><span><b id="cTax">0¢</b>income tax</span></span>
        <span class="spk"><i style="background:var(--claw)"></i><span><b id="cClaw">0¢</b>lost benefits</span></span>
        <span class="spk"><i style="background:var(--keep)"></i><span><b id="cKeep">0¢</b>you keep</span></span>
      </div>
      <div style="margin-top:14px;font-size:13px;line-height:1.55" id="dollarWhy"></div>
    </div>
    <div class="block">
      <div class="block-h">
        <h3>Where the paycheque goes</h3>
        <span class="sub">Gross to net, before any contribution</span>
      </div>
      <div class="dt-wrap" style="max-height:none">
        <table class="dt" style="min-width:420px"><thead><tr>
          <th>Line</th><th>Annual</th><th>Monthly</th><th>% of gross</th>
        </tr></thead><tbody id="takehome"></tbody></table>
      </div>
      <div class="assum">CPP and EI are excluded from the marginal rate above by
      design — they are levied on gross employment income and an RRSP deduction
      does not reduce them. They are still most of the gap between gross and net,
      so they belong here.</div>
    </div>
  </section>

  <!-- Allocation now lives on allocate.html: it is a question in its own
       right (income in, funding order out) and was buried as tab three. -->

  <!-- SCHEDULE -->
  <section class="tabpanel" id="tab-sched" role="tabpanel" aria-labelledby="tabbtn-sched" hidden>
    <div class="block">
      <div class="block-h">
        <h3>Year-by-year schedule</h3>
        <span class="btnrow"><button class="btn" type="button" id="dlCsv2">Download CSV</button></span>
      </div>
      <div class="dt-wrap">
        <table class="dt"><thead><tr>
          <th>Year</th><th>Age</th><th>Contributed</th><th>Gov't help</th>
          <th>Growth</th><th>Balance</th><th>Drawdown at target rate</th>
        </tr></thead><tbody id="schedBody"></tbody></table>
      </div>
      <div class="assum" id="schedNote"></div>
    </div>
  </section>
</main>

</div>
</div>

<footer>
  Federal brackets: CRA 2026. British Columbia brackets: Province of B.C. Canada Child Benefit: 2026–27 benefit year.
  CPP and OAS: Canada.ca, January 2026 — average, not maximum. <span id="basisFoot"></span>
  Everything runs in your browser; nothing you type is sent anywhere or stored. The only thing kept on
  your device is whether you prefer the light or dark theme.
  <br><br>
  This is an educational model, not tax, financial, or investment advice. Investment returns are not guaranteed and past performance does not predict future results.
  It does not account for every credit, deduction, or personal circumstance. Confirm your contribution room in CRA My Account, and consider speaking to a qualified professional before acting.
</footer>
