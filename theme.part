/* ================================================================
   THEME — shared by index.html and learn.html
   ================================================================
   Self-contained: the calculator page loads this after its own app code,
   the Learn page loads it alone, so it declares no globals either page
   might already own. Pages that need to react (the chart bakes gradients
   into markup at draw time) set window.onThemeChange. */
(function(){
  var el=function(id){return document.getElementById(id);};
  var TINT={light:"#0E1B2C",dark:"#0A121C",term:"#080809"};
  var ORDER=["term","light","dark"];   /* terminal is the default */
  var NAME={term:"Terminal",light:"Light",dark:"Dark"};

  function apply(mode,remember){
    document.documentElement.dataset.theme=mode;
    var dark=mode!=="light", btn=el("themeBtn"), label=el("themeLabel");
    if(label)label.textContent=NAME[mode]||"Light";
    if(btn){
      btn.setAttribute("aria-pressed",String(dark));
      var nxt=ORDER[(ORDER.indexOf(mode)+1)%ORDER.length];
      btn.setAttribute("aria-label","Switch to the "+(NAME[nxt]||nxt).toLowerCase()+" theme");
    }
    var meta=document.querySelector('meta[name="theme-color"]');
    if(meta)meta.setAttribute("content",TINT[mode]);
    if(remember){
      window.__theme.explicit=true;
      try{localStorage.setItem(window.__theme.key,mode);}catch(e){}
    }
    if(window.onThemeChange)window.onThemeChange();
  }

  var btn=el("themeBtn");
  if(btn)btn.addEventListener("click",function(){
    apply(ORDER[(ORDER.indexOf(document.documentElement.dataset.theme)+1)%ORDER.length],true);
  });

  /* The OS preference no longer selects the default -- terminal is the house
     look and applies whatever the system says. Following prefers-color-scheme
     here would have yanked an un-chosen visitor out of it the moment their
     machine flipped to light at sunrise. Light and dark remain one and two
     clicks away, and an explicit choice is remembered. */

  /* Sync the button label and tint to whatever the head script resolved. */
  apply(NAME[document.documentElement.dataset.theme]?document.documentElement.dataset.theme:"term",false);
})();
